<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_demurrage_daily_activities" model="ir.cron">
            <field name="name">Demoras: actividades diarias</field>
            <field name="model_id" ref="model_demurrage_container"/>
            <field name="state">code</field>
            <field name="code">model._cron_daily()</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=6, minute=0, second=0, microsecond=0).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>
    </data>
</odoo>
