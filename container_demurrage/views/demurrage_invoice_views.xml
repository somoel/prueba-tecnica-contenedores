<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_demurrage_invoice_wizard_form" model="ir.ui.view">
        <field name="name">demurrage.invoice.wizard.form</field>
        <field name="model">demurrage.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Facturar contenedores">
                <group>
                    <field name="partner_id"/>
                    <field name="invoice_date"/>
                </group>
                <group>
                    <field name="container_ids"/>
                </group>
                <footer>
                    <button name="action_create_invoice" type="object"
                            string="Facturar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_demurrage_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Facturar contenedores</field>
        <field name="res_model">demurrage.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_demurrage_invoice_wizard" name="Facturar contenedores"
              parent="menu_demurrage_billing"
              action="action_demurrage_invoice_wizard" sequence="20"/>
</odoo>