<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_demurrage_import_wizard_form" model="ir.ui.view">
        <field name="name">demurrage.import.wizard.form</field>
        <field name="model">demurrage.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar contenedores">
                <sheet>
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                        <field name="state" readonly="1"/>
                    </group>
                    <field name="line_ids" readonly="1"/>
                    <group>
                        <field name="total_count"/>
                        <field name="importable_count"/>
                        <field name="imported_count"/>
                        <field name="rejected_count"/>
                        <field name="warning_count"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_analyze" string="Analizar" type="object" class="btn-primary"/>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_demurrage_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar contenedores</field>
        <field name="res_model">demurrage.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
