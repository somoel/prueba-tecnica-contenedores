<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_demurrage" model="ir.module.category">
            <field name="name">Demoras</field>
            <field name="sequence">90</field>
        </record>

        <record id="group_demurrage_operations" model="res.groups">
            <field name="name">Operaciones</field>
            <field name="category_id" ref="module_category_demurrage"/>
        </record>

        <record id="group_demurrage_billing" model="res.groups">
            <field name="name">Facturación</field>
            <field name="category_id" ref="module_category_demurrage"/>
            <field name="implied_ids" eval="[(4, ref('container_demurrage.group_demurrage_operations'))]"/>
        </record>

        <record id="group_demurrage_manager" model="res.groups">
            <field name="name">Gerencia</field>
            <field name="category_id" ref="module_category_demurrage"/>
            <field name="implied_ids" eval="[(4, ref('container_demurrage.group_demurrage_billing'))]"/>
        </record>
    </data>
</odoo>